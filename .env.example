# מסד נתונים (חובה בפרודקשן, שומר את החדרים). בוחרים אחד:
# א. Turso (Vercel → Storage → Turso): המשתנים מתווספים אוטומטית
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# ב. Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (אפשר גם KV_REST_API_URL / KV_REST_API_TOKEN של Vercel)
# בלי אחד מהם החדרים נשמרים בזיכרון, מתאים רק לפיתוח מקומי.

# אופציונלי: כתובת האתר המלאה לתצוגה המקדימה של קישורי הזמנה (ב-Vercel הכתובת נקבעת אוטומטית)
NEXT_PUBLIC_SITE_URL=

# ============================================
# פרסומות (כבוי כברירת מחדל)
# ============================================
# כניסה לסביבת הניהול /admin (מספיק אחד מהשניים):
# א. קישור כניסה במייל: מפתח מ-resend.com (נרשמים עם אותה כתובת מייל של המנהל)
RESEND_API_KEY=
ADMIN_EMAIL=gilbeny@gmail.com
# ב. מפתח ארוך וסודי שמקלידים בדף הכניסה
ADS_ADMIN_KEY=
# Google AdSense (רק אם מדליקים אותו בניהול): מזהה האתר ומזהה יחידה לכל מיקום
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_LOBBY=
NEXT_PUBLIC_ADSENSE_SLOT_ROUNDEND=
