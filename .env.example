# Upstash Redis (חובה בפרודקשן, שומר את החדרים). בלי זה החדרים נשמרים בזיכרון, מתאים רק לפיתוח.
# (אפשר גם KV_REST_API_URL / KV_REST_API_TOKEN של Vercel Storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# כתובת האתר המלאה, לתצוגה המקדימה של קישורי הזמנה, למשל https://alias-games.vercel.app
NEXT_PUBLIC_SITE_URL=

# ============================================
# פרסומות (כבוי כברירת מחדל)
# ============================================
# מפתח ארוך וסודי לסביבת הניהול /admin. בלי זה סביבת הניהול לא קיימת.
ADS_ADMIN_KEY=
# Google AdSense (רק אם מדליקים אותו בניהול): מזהה האתר ומזהה יחידה לכל מיקום
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_LOBBY=
NEXT_PUBLIC_ADSENSE_SLOT_ROUNDEND=
